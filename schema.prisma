generator client { provider = "prisma-client-js" }
datasource db { provider = "postgresql" url = env("DATABASE_URL") }

enum Role { SUPERADMIN ADMIN TEACHER STUDENT PARENT ACCOUNTANT }
enum AttendanceStatus { PRESENT ABSENT LATE EXCUSED }
enum PaymentStatus { PENDING PAID PARTIAL }

model School { id String @id @default(cuid()); name String; code String @unique; city String @default("Lubumbashi"); createdAt DateTime @default(now()); users User[]; classes Class[]; students Student[]; subjects Subject[]; payments Payment[] }
model User { id String @id @default(cuid()); email String @unique; passwordHash String; name String; role Role; schoolId String?; school School? @relation(fields:[schoolId], references:[id]); createdAt DateTime @default(now()); student Student?; parent Parent?; teacher Teacher? }
model Parent { id String @id @default(cuid()); userId String @unique; user User @relation(fields:[userId], references:[id]); students Student[] }
model Teacher { id String @id @default(cuid()); userId String @unique; user User @relation(fields:[userId], references:[id]); subjects Subject[] }
model Student { id String @id @default(cuid()); matricule String @unique; name String; birthDate DateTime?; schoolId String; school School @relation(fields:[schoolId], references:[id]); classId String?; class Class? @relation(fields:[classId], references:[id]); parentId String?; parent Parent? @relation(fields:[parentId], references:[id]); grades Grade[]; attendance Attendance[] }
model Class { id String @id @default(cuid()); name String; schoolId String; school School @relation(fields:[schoolId], references:[id]); students Student[]; grades Grade[]; attendance Attendance[] }
model Subject { id String @id @default(cuid()); name String; coefficient Int @default(1); schoolId String; school School @relation(fields:[schoolId], references:[id]); teacherId String?; teacher Teacher? @relation(fields:[teacherId], references:[id]); grades Grade[] }
model Grade { id String @id @default(cuid()); studentId String; student Student @relation(fields:[studentId], references:[id]); subjectId String; subject Subject @relation(fields:[subjectId], references:[id]); classId String; class Class @relation(fields:[classId], references:[id]); value Float; term String; createdAt DateTime @default(now()) }
model Attendance { id String @id @default(cuid()); studentId String; student Student @relation(fields:[studentId], references:[id]); classId String; class Class @relation(fields:[classId], references:[id]); date DateTime; status AttendanceStatus; note String?; @@unique([studentId,date]) }
model Payment { id String @id @default(cuid()); schoolId String; school School @relation(fields:[schoolId], references:[id]); studentId String; amount Int; currency String @default("CDF"); status PaymentStatus @default(PAID); reference String @unique; description String; createdAt DateTime @default(now()) }
